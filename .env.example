PORT=8080
OAIPROXY_AUTH_TOKEN=change-me

# 开发默认开启 debug（npm run dev 已设置 OAIPROXY_DEBUG=1）
OAIPROXY_DEBUG=1
OAIPROXY_DEBUG_DIR=./logs
OAIPROXY_IPV4_ONLY=0
OAIPROXY_USE_ENV_PROXY=0

# A2ABase backend
A2ABASE_API_URL=https://a2abase.ai/api
A2ABASE_TIMEOUT_MS=30000

# Agent pool
OAIPROXY_AGENT_POOL_SIZE=8
OAIPROXY_MAX_AGENTS=10
